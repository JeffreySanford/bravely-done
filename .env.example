# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.
#
# The backend loads .env via `import 'dotenv/config'` as the very first line
# of apps/backend/src/main.ts, before AppModule's providers are constructed —
# JwtStrategy and PrismaService both read process.env at construction time,
# so a value missing here surfaces as a confusing startup failure rather than
# a clear "not configured" message.

# --- Database ---
# Consumed by PrismaService (apps/backend/src/prisma/prisma.service.ts) and by
# every Prisma CLI command (db:migrate, db:generate). Matches the credentials
# in docker/docker-compose.yml, which `pnpm db:up` starts.
DATABASE_URL=postgresql://bravely:bravely_dev_only@localhost:5432/bravely_done?schema=public

# --- Auth ---
# Signs access/refresh JWTs (apps/backend/src/auth/). Use a long random value
# in any shared or deployed environment — a guessable secret lets anyone mint
# a valid token for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- CORS ---
# The single browser origin allowed to send credentialed requests (see
# main.ts's enableCors). Must match exactly where the frontend is served from,
# scheme and port included — cookies are rejected on a mismatch.
FRONTEND_ORIGIN=http://localhost:4200

# --- Server ---
# Port the backend listens on. The frontend's apiUrl
# (apps/frontend/src/environments/environment.ts) points at
# http://localhost:3000/api, so changing this means changing that too.
PORT=3000

# --- Tooling (optional) ---
# Fine-grained GitHub PAT scoped to this repo (Contents, Issues, Pull requests).
# Used by the "github" server in .mcp.json. Only needed for MCP-driven GitHub
# work — the app itself runs fine without it.
GITHUB_PERSONAL_ACCESS_TOKEN=
