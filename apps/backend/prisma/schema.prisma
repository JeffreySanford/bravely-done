generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(PLAYER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  characters   Character[]

  @@map("users")
}

/// A user account can hold multiple characters (character select, not
/// Base Camp, is the app's landing page — see character-select.md).
/// Deliberately minimal for now: role/skill-tree progression, avatar
/// choice, and XP land in later milestones on top of this.
model Character {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set true the first time this character reaches Base Camp — gates the
  /// one-time tent-erect animation (see documentation/product/base-camp.md).
  hasArrivedAtCamp Boolean @default(false)
  /// Bridge repair progress from the first construction arc (see planning/
  /// 02-base-camp-animations.md). Advanced by completing quests.
  campConstructionStage Int @default(0)
  /// Resource gathered by chopping trees at Base Camp — feeds the
  /// campfire's fuel state for real (see planning/02-base-camp-
  /// animations.md's resource loop). Deliberately simple: one resource
  /// type, no depletion per tree, chopping is an infinite ambient action.
  firewoodCount Int @default(0)
  /// Resource gathered by harvesting the foraging bush at Base Camp.
  /// Deliberately simple, mirrors firewoodCount: one resource type, no
  /// depletion, harvesting is an infinite ambient action.
  forageCount Int @default(0)
  /// Quest XP (see documentation/product/rewards-retention.md's reward
  /// categories). Deliberately just one XP category for now — Courage/
  /// Focus/Wisdom XP require sprint and resolution variety this project
  /// doesn't have yet.
  xp    Int @default(0)
  /// Coins for ordinary progress (see rewards-retention.md). Spent on
  /// workbench upgrades — see CharacterService.WORKBENCH_UPGRADE_COSTS.
  coins Int @default(0)
  /// Capacity upgrades at Base Camp's workbench landmark (see planning/
  /// 02-base-camp-animations.md), capped at
  /// CharacterService.WORKBENCH_MAX_LEVEL. Deliberately just a level
  /// number for now — no actual capability unlocks are wired to it yet.
  workbenchLevel Int @default(0)
  quests    Quest[]

  @@map("characters")
}

enum QuestStatus {
  /// The backlog column — created but not yet started.
  OPEN
  /// The player has explicitly started work on this quest (see
  /// QuestService.start) — the board's "In Progress" column.
  IN_PROGRESS
  COMPLETED
  /// Abandoned without penalty — "rest days and comeback quests are
  /// legitimate play" (documentation/product/rewards-retention.md's
  /// ethical rules). Grants no reward and does not advance camp
  /// construction, but is a deliberate, real resolution, not a failure
  /// state.
  RETREATED
}

/// Deliberately minimal first slice of the real quest system (see planning/
/// 03-first-brave-step.md): a title, a status, and (once completed) a
/// deterministic reward. Sprint scheduling, encounters, and idempotency
/// keys are later milestones layered on top of this, not built yet.
model Quest {
  id          String      @id @default(uuid())
  characterId String
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String
  status      QuestStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  @@map("quests")
}

/// One row per refresh-token session. Refresh tokens are DB-backed (not
/// stateless rotating JWTs) so individual sessions can be revoked without a
/// blocklist. Only a hash of the refresh token is stored, never the raw value.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@map("sessions")
}
