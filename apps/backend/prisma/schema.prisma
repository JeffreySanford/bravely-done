generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(PLAYER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  characters   Character[]

  @@map("users")
}

/// A user account can hold multiple characters (character select, not
/// Base Camp, is the app's landing page — see character-select.md).
/// Deliberately minimal for now: role/skill-tree progression, avatar
/// choice, and XP land in later milestones on top of this.
model Character {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set true the first time this character reaches Base Camp — gates the
  /// one-time tent-erect animation (see documentation/product/base-camp.md).
  hasArrivedAtCamp Boolean @default(false)
  /// Bridge repair progress from the first construction arc (see planning/
  /// 02-base-camp-animations.md). Advanced by completing quests.
  campConstructionStage Int @default(0)
  /// Resource gathered by chopping trees at Base Camp — feeds the
  /// campfire's fuel state for real (see planning/02-base-camp-
  /// animations.md's resource loop). Deliberately simple: one resource
  /// type, no depletion per tree, chopping is an infinite ambient action.
  firewoodCount Int @default(0)
  /// Resource gathered by harvesting the foraging bush at Base Camp.
  /// Deliberately simple, mirrors firewoodCount: one resource type, no
  /// depletion, harvesting is an infinite ambient action.
  forageCount Int @default(0)
  /// XP (see documentation/product/rewards-retention.md's reward
  /// categories). One aggregate counter fed by multiple reward categories —
  /// Quest XP (QuestService.QUEST_XP_REWARD), Focus XP
  /// (SprintService.FOCUS_XP_REWARD), and Courage XP
  /// (EncounterService.COURAGE_XP_REWARD) all add here; Wisdom XP needs
  /// resolution variety this project doesn't have yet.
  xp    Int @default(0)
  /// Coins for ordinary progress (see rewards-retention.md). Spent on
  /// workbench upgrades — see CharacterService.WORKBENCH_UPGRADE_COSTS.
  coins Int @default(0)
  /// Capacity upgrades at Base Camp's workbench landmark (see planning/
  /// 02-base-camp-animations.md), capped at
  /// CharacterService.WORKBENCH_MAX_LEVEL. Deliberately just a level
  /// number for now — no actual capability unlocks are wired to it yet.
  workbenchLevel Int @default(0)
  /// The UTC calendar day (truncated to midnight) on which the First Brave
  /// Step daily bonus was last granted — see QuestService.complete()'s
  /// FIRST_BRAVE_STEP_XP_REWARD/COIN_REWARD. Compared against "today" (also
  /// UTC) so the bonus fires at most once per day, on whichever quest
  /// completion happens to be first — no login-time or passive-time
  /// component, so it can't be farmed by idle timers.
  firstBraveStepDay DateTime?
  quests    Quest[]
  rewardEntries RewardEntry[]

  @@map("characters")
}

/// Which mechanic produced a ledger entry. Mirrors the reward categories in
/// documentation/product/rewards-retention.md, plus the one *spend* the game
/// has — including spends is what makes the ledger reconcilable against
/// Character.xp/coins rather than merely additive.
enum RewardCategory {
  /// Full credit for completing a quest (QuestService.QUEST_XP_REWARD).
  QUEST
  /// Half credit for the Split resolution.
  SPLIT
  /// Focus XP for an honest completed sprint.
  FOCUS
  /// Courage XP for completing an encounter.
  COURAGE
  /// Daily loop: first completion of a UTC day.
  FIRST_BRAVE_STEP
  /// Daily loop: completing a quest designated as one of Today's Three.
  TODAYS_THREE
  /// Coins spent on a workbench upgrade — recorded with negative `coins`.
  WORKBENCH_UPGRADE
}

/// Append-only record of every XP/coin movement. Written inside the same
/// transaction as the balance change it describes, so a grant can never
/// exist without its entry (or vice versa).
///
/// Character.xp/coins remain the authoritative *current balance* — this
/// table is history, not a replacement. That's a deliberate choice: making
/// the ledger the source of truth would mean recomputing a SUM on every
/// read and backfilling opening balances, which is a much larger change
/// than the reporting problem it would solve. The two are kept consistent
/// by always writing them together; `reconcile` coverage in
/// reward-ledger.service.spec.ts and the integration suite asserts it.
///
/// Rows are never updated or deleted — a correction is a new compensating
/// entry, so history stays truthful about what was granted at the time.
model RewardEntry {
  id          String         @id @default(uuid())
  characterId String
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  category    RewardCategory
  /// Signed. Positive for grants, negative for spends.
  xp          Int            @default(0)
  coins       Int            @default(0)
  /// The quest/sprint/encounter/character this entry came from, for tracing
  /// an entry back to what caused it. Deliberately not a foreign key: the
  /// ledger must survive its source being deleted, or history would quietly
  /// rewrite itself.
  sourceId    String?
  createdAt   DateTime       @default(now())

  /// Period queries always filter by character and time window.
  @@index([characterId, createdAt])
  @@map("reward_entries")
}

enum QuestStatus {
  /// The backlog column — created but not yet started.
  OPEN
  /// The player has explicitly started work on this quest (see
  /// QuestService.start) — the board's "In Progress" column.
  IN_PROGRESS
  COMPLETED
  /// Abandoned without penalty — "rest days and comeback quests are
  /// legitimate play" (documentation/product/rewards-retention.md's
  /// ethical rules). Grants no reward and does not advance camp
  /// construction, but is a deliberate, real resolution, not a failure
  /// state.
  RETREATED
  /// Partial credit — "meaningful progress made, but the quest as scoped
  /// won't be finished" (game-loop.md's five resolutions). Grants half
  /// QUEST_XP_REWARD/QUEST_COIN_REWARD (rounded down) via QuestService.split
  /// and resolves the quest, distinct from both Complete (full credit) and
  /// Retreat (no credit).
  SPLIT
}

/// Deliberately minimal first slice of the real quest system (see planning/
/// 03-first-brave-step.md): a title, a status, and (once completed) a
/// deterministic reward.
model Quest {
  id          String      @id @default(uuid())
  characterId String
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String
  status      QuestStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  completedAt DateTime?
  /// Stamped by QuestService.continue() — the "Continue" resolution
  /// (game-loop.md: "meaningful progress made; another encounter remains").
  /// Updated on every continue, not just the first, since a player may
  /// continue the same quest across many sessions. No reward attached
  /// (same reward-free precedent as retreat); this is durable history for
  /// a future Chronicle/session-summary feature, not shown prominently yet.
  lastContinuedAt DateTime?
  /// The client-supplied idempotency key from the most recently processed
  /// resolution call (complete/continue/retreat/split) on this quest, if
  /// any. A duplicate network retry carrying the same key as the last one
  /// processed is returned as-is without re-executing the mutation — this
  /// matters most for continue(), which is deliberately NOT idempotent by
  /// status alone (it re-stamps on every real call), so without a key a
  /// retry would be indistinguishable from a second genuine continue.
  lastIdempotencyKey String?
  /// The UTC calendar day (truncated to midnight) this quest was designated
  /// as one of the player's "Today's Three" (rewards-retention.md's Daily
  /// cadence — QuestService.designateTodaysThree/undesignateTodaysThree).
  /// At most 3 quests may share the same day value per character. Compared
  /// against "today" to compute QuestDto.isTodaysThree — a stale value from
  /// a previous day just quietly stops counting, no explicit expiry needed.
  /// Completing a quest while its day matches today grants
  /// TODAYS_THREE_BONUS_XP_REWARD/COIN_REWARD on top of the normal reward.
  todaysThreeDay DateTime?
  /// When this quest reached *any* terminal resolution — completed, retreated,
  /// or split. `completedAt` only ever marks a COMPLETED quest, so before this
  /// field existed a retreat or a split couldn't be placed in time at all,
  /// which made them invisible to the Chronicle (see ChronicleService).
  /// Rows resolved before this field was added keep it null and are simply
  /// absent from Chronicle windows — no backfill, since inventing a
  /// resolution time would be worse than admitting it isn't known.
  resolvedAt DateTime?
  sprints     Sprint[]
  encounters  Encounter[]

  @@map("quests")
}

enum EncounterStatus {
  OPEN
  COMPLETED
}

/// A small actionable step within a quest — "Encounter" in documentation/
/// product/agile-safe-progression.md's dual-labeled vocabulary
/// (Subtask → Encounter). Deliberately simple for this first slice: a
/// checklist item, not its own resolution flow like Quest or Sprint — no
/// retreat-equivalent, and completing one never gates or auto-triggers
/// quest completion (see EncounterService). Completing one grants a small
/// flat Courage XP reward ("Courage XP for beginning avoided work" —
/// rewards-retention.md), making that reward category real.
model Encounter {
  id          String          @id @default(uuid())
  questId     String
  quest       Quest           @relation(fields: [questId], references: [id], onDelete: Cascade)
  title       String
  status      EncounterStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  @@map("encounters")
}

enum SprintStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

/// A focused work session against a quest — "Adventure Sprint" in
/// documentation/product/agile-safe-progression.md's dual-labeled
/// vocabulary. Deliberately timestamp-authoritative, not a client-trusted
/// countdown: elapsed active time is always recomputed server-side from
/// startedAt/pausedAt/pausedSeconds (see SprintService), both so a reload
/// can recover the true state and so the completion reward can't be
/// inflated by a client claiming more elapsed time than actually passed —
/// see rewards-retention.md's "resist idle timers" rule.
model Sprint {
  id            String       @id @default(uuid())
  questId       String
  quest         Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)
  /// One of SprintService.SPRINT_DURATION_PRESETS_SECONDS — validated at
  /// creation, not an arbitrary player-supplied value.
  targetSeconds Int
  startedAt     DateTime     @default(now())
  /// Set while status is PAUSED; null otherwise. Combined with
  /// pausedSeconds to compute total paused time without losing precision
  /// across multiple pause/resume cycles.
  pausedAt      DateTime?
  pausedSeconds Int          @default(0)
  status        SprintStatus @default(ACTIVE)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@map("sprints")
}

/// One row per refresh-token session. Refresh tokens are DB-backed (not
/// stateless rotating JWTs) so individual sessions can be revoked without a
/// blocklist. Only a hash of the refresh token is stored, never the raw value.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@map("sessions")
}
