generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(PLAYER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  characters   Character[]

  @@map("users")
}

/// A user account can hold multiple characters (character select, not
/// Base Camp, is the app's landing page — see character-select.md).
/// Deliberately minimal for now: role/skill-tree progression, avatar
/// choice, and XP land in later milestones on top of this.
model Character {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("characters")
}

/// One row per refresh-token session. Refresh tokens are DB-backed (not
/// stateless rotating JWTs) so individual sessions can be revoked without a
/// blocklist. Only a hash of the refresh token is stored, never the raw value.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@map("sessions")
}
